
# Python virtual environment
# Contains installed packages that don't need to be uploaded
.venv/
venv/

# Python cache files
# Automatically generated when Python runs
__pycache__/
*.pyc

# Environment variables and API keys
# Keeps private credentials out of GitHub
.env
.env.*

# macOS system files
.DS_Store

# VS Code local settings
.vscode/

# Locally downloaded vulnerability datasets
# These can be regenerated by running our pipeline
data/raw/
data/processed/
